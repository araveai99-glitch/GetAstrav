# FounderOS Environment Variables

# Supabase Credentials (Client Safe)
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-Side Only Secrets (DO NOT EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:password@localhost:5432/founderos

# AI Configuration (Server Side Only)
GEMINI_API_KEY=your-gemini-api-key

# Email Dispatch Configuration (Server Side Only)
RESEND_API_KEY=re_your_resend_api_key
NOTIFICATIONS_FROM_EMAIL=notifications@founderos.app

# Server Port
PORT=5000
